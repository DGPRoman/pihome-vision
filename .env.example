# Copy to .env for a development run, or to the file the service unit reads, and
# fill in real values. Bare KEY=value: under systemd quotes become part of the value.
# Keep the real file readable only by its owner (chmod 600): it holds the camera's
# password and the key to every relay on the hub.

# The camera, with its credentials. rtsp://, rtsps://, http(s)://, or cam:N for a
# webcam on this machine. The address is never printed with its password in it.
PIHOME_VISION_CAMERA_URL=rtsp://user:password@192.168.1.50:554/stream2

# The hub's origin, nothing after it. https, unless the address is private.
PIHOME_VISION_HUB_URL=https://203.0.113.10

# The hub's relay key: PIHOME_RELAY_API_KEY in the hub's own environment.
PIHOME_VISION_HUB_KEY=replace-me-with-the-hubs-relay-key

# Everything that is not a secret. Optional; this is the default.
# PIHOME_VISION_CONFIG_PATH=config/vision.yaml
